{
  "name": "zipline-transportation-system",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Modules": {
        "$path": "Packages",
        "$ignoreUnknownInstances": true,

        "ZiplineTransport": {
          "$path": "src/ReplicatedStorage/ZiplineTransport"
        }
      }
    },

    "Workspace": {
      "$path": "src/Workspace",
      "$ignoreUnknownInstances": true
    }
  },
  "globIgnorePaths": ["**/wally.toml"]
}